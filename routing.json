{
  "version": "2026-06-18",
  "note": "Living intent->tool map. The intent-router hook reads this every prompt and surfaces the best match, so neither Adam nor Claude must memorize the toolset. Self-tuned: coverage-guard flags unrouted tools; weekly-evolve proposes edits from routing-log.jsonl misroutes. Patterns are lowercased substrings; word boundaries preferred. Keep `tool` matching an actual skill/command/workflow name.",
  "routes": [
    { "id": "ship", "patterns": ["ship it", "ship this", "commit and push", "push it", "ready to ship", "let's ship", "deploy this", " cap "], "tool": "/cap", "why": "preflight (lint/types/tests/build/env) + commit + push, blocks on failure", "tier": "core" },
    { "id": "commit-only", "patterns": ["just commit", "commit message", "write a commit"], "tool": "/caveman-commit", "why": "terse <=50char conventional commit, no checks/push", "tier": "core" },
    { "id": "plan-feature", "patterns": ["i need to add", "i want to build", "new feature", "implement a", "let's build", "add a flow", "build a"], "tool": "planner agent -> slice spec -> tdd-guide", "why": "decompose into slices before coding; Tier-1 auto-triggers safe-feature-slice", "tier": "core" },
    { "id": "tier1", "patterns": ["refund", "payment", "payout", "billing", "auth", "login", "permission", "rls", "webhook", "state transition", "money", "stripe", "checkout"], "tool": "safe-feature-slice skill", "why": "Tier-1 surface — invariant-preserving workflow REQUIRED (money/auth/RLS/webhooks/state)", "tier": "core" },
    { "id": "build-broken", "patterns": ["build is broken", "build broke", "build fails", "build failing", "type error", "won't compile", "tsc error"], "tool": "build-error-resolver agent / /build-fix", "why": "minimal-diff build/type fixes, report first errors", "tier": "core" },
    { "id": "tests-red", "patterns": ["tests failing", "test suite is red", "tests are red", "failing tests", "don't want to babysit", "fix the tests", "make tests pass"], "tool": "eval-fix-loop workflow", "why": "agent drives the suite green in a worktree, never weakens tests", "tier": "red" },
    { "id": "review", "patterns": ["review this", "code review", "review the", "review my", "is this safe", "merge safe", "audit this change", "look over"], "tool": "parallel-review workflow", "why": "claude + security + codex, adversarially verified, ranked — before /cap", "tier": "red" },
    { "id": "security", "patterns": ["security review", "is this secure", "vulnerab", "idor", "injection", "owasp", "leak", "exposed"], "tool": "security-reviewer agent", "why": "OWASP/RLS/auth/IDOR/secrets pass", "tier": "core" },
    { "id": "exhaustive-audit", "patterns": ["exhaustive", "thoroughly audit", "be comprehensive", "find all", "every bug", "deep audit", "sweep the whole"], "tool": "Workflow (ultracode)", "why": "multi-agent fan-out + adversarial verify; estimate cost, respect opt-in", "tier": "red" },
    { "id": "design", "patterns": ["looks bland", "redesign", "make it pretty", "ui", "ux", "landing page", "polish the", "design", "frontend craft", "bolder", "delight"], "tool": "impeccable skill", "why": "frontend craft; reads PRODUCT.md + DESIGN.md", "tier": "core" },
    { "id": "refactor", "patterns": ["refactor", "clean up", "dead code", "consolidate", "tidy"], "tool": "architect agent -> refactor-cleaner", "why": "target state first, then knip/ts-prune dead-code sweep", "tier": "core" },
    { "id": "marketing-email", "patterns": ["cold email", "outreach", "prospecting", "sdr", "outbound"], "tool": "cold-email skill", "why": "B2B cold outreach + follow-ups; loads product-marketing.md", "tier": "marketing" },
    { "id": "marketing-cro", "patterns": ["not converting", "conversion", "cro", "landing page sucks", "form abandon"], "tool": "cro skill", "why": "conversion optimization for pages/forms", "tier": "marketing" },
    { "id": "marketing-pricing", "patterns": ["pricing", "how much should i charge", "freemium", "packaging", "willingness to pay"], "tool": "pricing skill", "why": "packaging/tiers/monetization", "tier": "marketing" },
    { "id": "marketing-launch", "patterns": ["launch", "product hunt", "go-to-market", "gtm", "announcement", "waitlist"], "tool": "launch skill", "why": "launch/GTM playbook", "tier": "marketing" },
    { "id": "what-to-work-on", "patterns": ["what should i work on", "what's next", "where do i start", "what needs attention", "morning"], "tool": "/morning-briefing or /dashboard", "why": "cross-project state; briefing=depth, dashboard=fast facts", "tier": "core" },
    { "id": "prior-art", "patterns": ["have we done", "did we solve", "how did we", "prior decision", "decided before", "anywhere else"], "tool": "/decisions search", "why": "cross-project decisions index — check before reinventing", "tier": "core" },
    { "id": "verify", "patterns": ["does it work", "verify", "confirm the fix", "test it manually", "did that work"], "tool": "/verify or /qa", "why": "verify=run+observe, qa=browser walkthrough via Codex", "tier": "core" },
    { "id": "bloated-file", "patterns": ["too verbose", "too long", "compress this", "trim this file", "bloated"], "tool": "/caveman-compress", "why": "compress word count without losing meaning", "tier": "core" },
    { "id": "new-project", "patterns": ["new project", "unfamiliar repo", "just cloned", "onboard", "set up claude here"], "tool": "/onboard-project -> codebase-onboarding", "why": "audit vs canonical template, scaffold missing pieces", "tier": "core" },
    { "id": "self-improve", "patterns": ["improve the setup", "evolve", "self-improve", "get better", "train yourself", "harness better"], "tool": "harness-evolve workflow / /digest", "why": "eval-gated mutation of skills/rules; digest mines telemetry", "tier": "red" },
    { "id": "overnight", "patterns": ["overnight", "while i sleep", "unattended", "run it tonight"], "tool": "/overnight", "why": "semi-autonomous harness-only run, branch + morning report", "tier": "red" },
    { "id": "watch", "patterns": ["watch the", "keep an eye", "monitor prs", "monitor ci", "notify me when"], "tool": "/bg-watch", "why": "standing PR/CI watcher across repos", "tier": "red" },
    { "id": "ask-harness", "patterns": ["what changed in", "status of", "what's the state of", "remind me about", "what do we know about"], "tool": "harness-state MCP", "why": "query MEMORY/decisions/telemetry/project-status as tools", "tier": "red" },
    { "id": "ci-agent", "patterns": ["auto review prs", "review every pr", "claude in ci", "github action", "pr bot"], "tool": "scripts/setup-ci-agent.sh", "why": "fan the Claude GitHub Action to a repo", "tier": "red" },
    { "id": "log-bug", "patterns": ["that fixed it", "fixed the bug", "got it working", "that was the issue", "found the problem"], "tool": "/log-mistake", "why": "capture root cause + class to prevent + add a regression eval (flywheel fuel)", "tier": "red" },
    { "id": "migration", "patterns": ["migration", "schema change", "alter table", "add a column", "drizzle", "prisma migrate"], "tool": "database-migrations skill", "why": "zero-downtime schema/data migration patterns", "tier": "core" },
    { "id": "deep-research", "patterns": ["research", "compare options", "what's the best", "look into", "investigate the landscape"], "tool": "/deep-research", "why": "fan-out web search + adversarial verify + cited report", "tier": "core" },
    { "id": "multi-repo", "patterns": ["across all repos", "every project", "all my repos", "all 20", "everywhere"], "tool": "multi-repo-sweep (build it first)", "why": "fan one task across all MEMORY projects — not yet built", "tier": "dormant" }
  ]
}
